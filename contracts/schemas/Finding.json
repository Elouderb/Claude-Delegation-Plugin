{
  "$defs": {
    "Claim": {
      "description": "An evidence-bearing assertion (proposal \u00a711.2).\n\n``confidence`` is in [0, 1]; ``evidence`` holds reference strings such as\n``dbgraph://CustomerOrder/CustomerId`` or ``event:...`` locating the support.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "confidence"
      ],
      "title": "Claim",
      "type": "object"
    }
  },
  "description": "A finding: evidence-bearing claims + recommended actions (proposal \u00a711.2).",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "finding",
      "default": "finding",
      "title": "Artifact Type",
      "type": "string"
    },
    "author_agent": {
      "title": "Author Agent",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Linked canonical task id (task_...), if any.",
      "title": "Task Id"
    }
  },
  "required": [
    "artifact_id",
    "author_agent"
  ],
  "title": "Finding",
  "type": "object"
}
