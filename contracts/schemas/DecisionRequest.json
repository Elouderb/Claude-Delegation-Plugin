{
  "description": "A request for a human/policy decision between options (proposal \u00a711.1).",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "decision_request",
      "default": "decision_request",
      "title": "Artifact Type",
      "type": "string"
    },
    "author_agent": {
      "title": "Author Agent",
      "type": "string"
    },
    "options": {
      "items": {
        "type": "string"
      },
      "title": "Options",
      "type": "array"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "recommendation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Linked canonical task id (task_...), if any.",
      "title": "Task Id"
    }
  },
  "required": [
    "artifact_id",
    "author_agent",
    "question"
  ],
  "title": "DecisionRequest",
  "type": "object"
}
