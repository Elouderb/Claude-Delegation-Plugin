{
  "description": "A reference to a code change (proposal \u00a711.1).\n\nA *reference*, not the diff itself: commit/branch identifiers and a summary,\nso reports can point at a change without forwarding its full contents.\n\n``author_agent`` is intentionally **optional** here (unlike the authored\nartifacts): a patch reference is often produced mechanically from git and its\nauthor is typically implied by the enclosing :class:`ExecutionReport`, so the\nfield is not required on the reference itself.",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "patch_reference",
      "default": "patch_reference",
      "title": "Artifact Type",
      "type": "string"
    },
    "author_agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Agent"
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch"
    },
    "commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit"
    },
    "diff_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diff Summary"
    },
    "files_changed": {
      "items": {
        "type": "string"
      },
      "title": "Files Changed",
      "type": "array"
    },
    "repository_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Id"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Linked canonical task id (task_...), if any.",
      "title": "Task Id"
    }
  },
  "required": [
    "artifact_id"
  ],
  "title": "PatchReference",
  "type": "object"
}
