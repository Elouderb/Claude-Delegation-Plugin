{
  "description": "A test-run result summary (proposal \u00a711.1).\n\n``author_agent`` is intentionally **optional** here (unlike the authored\nartifacts): a test report is usually emitted by a test runner rather than a\ndistinct authoring agent, and its author is implied by the enclosing\n:class:`ExecutionReport` when one exists.",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "test_report",
      "default": "test_report",
      "title": "Artifact Type",
      "type": "string"
    },
    "author_agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Agent"
    },
    "details": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "failed": {
      "default": 0,
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "passed": {
      "default": 0,
      "minimum": 0,
      "title": "Passed",
      "type": "integer"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "skipped": {
      "default": 0,
      "minimum": 0,
      "title": "Skipped",
      "type": "integer"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Linked canonical task id (task_...), if any.",
      "title": "Task Id"
    }
  },
  "required": [
    "artifact_id",
    "summary"
  ],
  "title": "TestReport",
  "type": "object"
}
