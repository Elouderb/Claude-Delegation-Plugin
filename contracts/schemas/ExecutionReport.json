{
  "description": "An agent's report on executing a task (proposal \u00a711.1).",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "execution_report",
      "default": "execution_report",
      "title": "Artifact Type",
      "type": "string"
    },
    "author_agent": {
      "title": "Author Agent",
      "type": "string"
    },
    "details": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "patch_reference_ids": {
      "items": {
        "type": "string"
      },
      "title": "Patch Reference Ids",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Linked canonical task id (task_...), if any.",
      "title": "Task Id"
    },
    "test_report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Report Id"
    }
  },
  "required": [
    "artifact_id",
    "author_agent",
    "status",
    "summary"
  ],
  "title": "ExecutionReport",
  "type": "object"
}
