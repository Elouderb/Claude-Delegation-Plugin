# Copy to .env and fill in real values. The .env file is gitignored and must
# never be committed. Only required if you use the database-graph tools, which
# connect to a Microsoft SQL Server instance.
#
# DRIVER: current Windows/macOS/Linux installs ship "ODBC Driver 18 for SQL
# Server" (Driver 17 is the older, often-absent version — copying it verbatim
# fails with a driver-not-found error). Discover what is actually installed with:
#     python -c "import pyodbc; print(pyodbc.drivers())"
# and set DRIVER to one of the names it prints.
#
# Encrypt=yes;TrustServerCertificate=yes: REQUIRED under Driver 18, which
# defaults encryption ON. Without this pair the connection fails (or rejects a
# self-signed/dev certificate). Under Driver 17 encryption defaulted off, so the
# pair was optional there — on 18 it is not.
DB_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server;DATABASE=your-db;UID=your-user;PWD=your-password;Encrypt=yes;TrustServerCertificate=yes;"

# --- Central Agent OS control plane (Phase 1c) ---------------------------------
# Only needed to run the /v1 API service (services/api) and the outbox drain
# worker (outbox/drain). All optional; the plugin is fully functional local-only
# without any of these. .env is gitignored — never commit a real key.
#
# Connection string the API service uses to reach the central store
# (agent_os_memory). Same driver/encrypt guidance as DB_CONNECTION_STRING above.
AGENT_OS_CENTRAL_DB_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server;DATABASE=agent_os_memory;UID=your-user;PWD=your-password;Encrypt=yes;TrustServerCertificate=yes;"
#
# Bearer key required on every /v1 route (constant-time compared). Generate a
# strong random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
# This value may be EITHER the shared ADMIN / bootstrap key (full authority:
# register machines + issue per-machine keys) OR a per-machine credential of the
# form "<key_id>.<secret>" issued via scripts/manage_keys.py — the server
# distinguishes by format, so a machine's .env just holds its own key with no
# client code change. A per-machine key is bound to its machine_id (can act only
# as itself); the admin key bypasses that binding, so keep it to the operator.
AGENT_OS_API_KEY="change-me-to-a-long-random-secret"
#
# Where the drain worker POSTs (default http://127.0.0.1:8765). The API binds
# AGENT_OS_API_HOST:AGENT_OS_API_PORT (default 127.0.0.1:8765 — loopback only).
AGENT_OS_API_URL="http://127.0.0.1:8765"
#
# Optional drain tuning: AGENT_OS_SYNC_INTERVAL (idle poll seconds, default 30),
# AGENT_OS_SYNC_BATCH (max events/batch, default 500), AGENT_OS_SYNC_TIMEOUT
# (per-request seconds, default 10). AGENT_OS_SYNC_DISABLED=1 is the drain
# kill-switch. AGENT_OS_SYNC=1 opts the MCP server into spawning the drain as a
# background companion (OFF by default so nothing phones home without consent).
