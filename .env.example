# Copy to .env and fill in real values. The .env file is gitignored and must
# never be committed. Only required if you use the database-graph tools, which
# connect to a Microsoft SQL Server instance.
#
# DRIVER: current Windows/macOS/Linux installs ship "ODBC Driver 18 for SQL
# Server" (Driver 17 is the older, often-absent version — copying it verbatim
# fails with a driver-not-found error). Discover what is actually installed with:
#     python -c "import pyodbc; print(pyodbc.drivers())"
# and set DRIVER to one of the names it prints.
#
# Encrypt=yes;TrustServerCertificate=yes: REQUIRED under Driver 18, which
# defaults encryption ON. Without this pair the connection fails (or rejects a
# self-signed/dev certificate). Under Driver 17 encryption defaulted off, so the
# pair was optional there — on 18 it is not.
DB_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server;DATABASE=your-db;UID=your-user;PWD=your-password;Encrypt=yes;TrustServerCertificate=yes;"
